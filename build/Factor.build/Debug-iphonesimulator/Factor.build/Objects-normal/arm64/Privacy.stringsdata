  "source": "/Users/tylerreckart/Dev/Factor/Factor/Views/Settings/Legal/Privacy.swift",
  "tables": {
    "Localizable": [
      {
        "comment": "",
        "key": "Privacy Policy",
        "location": {
          "startingColumn": 26,
          "startingLine": 45
        }
      },
      {
        "comment": "",
        "key": "Overview",
        "location": {
          "startingColumn": 26,
          "startingLine": 15
        }
      },
      {
        "comment": "",
        "key": "This Privacy Policy decribes how your personal information is handled in Factor.",
        "location": {
          "startingColumn": 26,
          "startingLine": 20
        }
      },
      {
        "comment": "",
        "key": "We Collect No Personal Information",
        "location": {
          "startingColumn": 26,
          "startingLine": 22
        }
      },
      {
        "comment": "",
        "key": "We do not collect, use, save, or have access to any of your personal data stored in Factor.",
        "location": {
          "startingColumn": 26,
          "startingLine": 27
        }
      },
      {
        "comment": "",
        "key": "Individual settings and any data generated by Factor are not personal and are stored only on your device. You may be asked to provide access to your photo library, but this is only so that you may open your photos in Factor and save them in your stored notes. We do not process that information at all and have no access to it.",
        "location": {
          "startingColumn": 26,
          "startingLine": 29
        }
      },
      {
        "comment": "",
        "key": "In addition, if you take a photo using Factor, location data is saved in the image, but we have no access to that data and it is not shared with anyone unless you yourself choose to share the image.",
        "location": {
          "startingColumn": 26,
          "startingLine": 31
        }
      },
      {
        "comment": "",
        "key": "Contact Us",
        "location": {
          "startingColumn": 26,
          "startingLine": 33
        }
      },
      {
        "comment": "",
        "key": "If you have any questions about this Privacy Policy, feel free to contact us at [support@haptic.software](mailto:support@haptic.software).",
        "location": {
          "startingColumn": 26,
          "startingLine": 38
        }
      }
    ]
  },
  "version": 1
}
